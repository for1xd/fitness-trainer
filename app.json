{
  "expo": {
    "name": "Фітнес-тренер",
    "slug": "fitness-trainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера потрібна, щоб фотографувати їжу та сканувати штрихкоди.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ до фото потрібен, щоб додати фото страви або тренажера.",
          "cameraPermission": "Камера потрібна, щоб фотографувати їжу."
        }
      ]
    ],
    "scheme": "fitnesstrainer",
    "experiments": {
      "typedRoutes": true
    }
  }
}
