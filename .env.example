# Скопіюй у .env і заповни. У клієнт потрапляють лише змінні з префіксом EXPO_PUBLIC_.
# Без цих змінних застосунок працює в режимі «без акаунта».
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Секрети Edge Functions (НЕ в .env клієнта!) ──
# Задаються командою: npx supabase secrets set ANTHROPIC_API_KEY=... USDA_API_KEY=...
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# USDA_API_KEY=
